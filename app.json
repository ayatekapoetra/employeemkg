    "version": "1.2.20",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "employeemkg",
    "userInterfaceStyle": "automatic",
      "newArchEnabled": true,
    "privacy": "public",
    "description": "Employee management application for CV. MAKKURAGA TAMA",
